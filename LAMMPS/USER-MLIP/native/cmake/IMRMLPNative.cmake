include_guard(GLOBAL)

get_filename_component(IMRMLP_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(IMRMLP_LIBRARY "${IMRMLP_ROOT}/build/mpi/libimrmlp-mpi.so" CACHE FILEPATH "Matching MPI IMR-MLP library")
set(IMRMLP_FLAGS_FILE "${IMRMLP_ROOT}/build/mpi/.flags" CACHE FILEPATH "Compile flags of that IMR-MLP library")
if(NOT EXISTS "${IMRMLP_LIBRARY}" OR NOT EXISTS "${IMRMLP_FLAGS_FILE}")
  message(FATAL_ERROR "Build the matching MPI IMR-MLP library first and supply its IMRMLP_FLAGS_FILE")
endif()
file(READ "${IMRMLP_FLAGS_FILE}" IMRMLP_FLAGS_TEXT)
string(STRIP "${IMRMLP_FLAGS_TEXT}" IMRMLP_FLAGS_TEXT)
if(NOT IMRMLP_FLAGS_TEXT MATCHES "-DIMRMLP_MPI([ =]|$)")
  message(FATAL_ERROR "mlip/native must link an MPI IMR-MLP build, not the serial MPI stubs")
endif()
set(IMRMLP_DETECTED_BACKEND CPU)
if(IMRMLP_FLAGS_TEXT MATCHES "-DIMRMLP_CUDA([ =]|$)")
  set(IMRMLP_DETECTED_BACKEND CUDA)
elseif(IMRMLP_FLAGS_TEXT MATCHES "-DIMRMLP_HIP([ =]|$)")
  set(IMRMLP_DETECTED_BACKEND HIP)
endif()
if((NOT IMRMLP_DETECTED_BACKEND STREQUAL "CPU" AND NOT IMRMLP_FLAGS_TEXT MATCHES "-DIMRMLP_GPU([ =]|$)")
   OR (IMRMLP_DETECTED_BACKEND STREQUAL "CPU" AND IMRMLP_FLAGS_TEXT MATCHES "-DIMRMLP_GPU([ =]|$)")
   OR (IMRMLP_FLAGS_TEXT MATCHES "-DIMRMLP_CUDA([ =]|$)" AND IMRMLP_FLAGS_TEXT MATCHES "-DIMRMLP_HIP([ =]|$)"))
  message(FATAL_ERROR "Inconsistent GPU backend definitions in IMRMLP_FLAGS_FILE")
endif()
string(REGEX REPLACE "-include (build/[^ ]+)" "-include ${IMRMLP_ROOT}/\\1" IMRMLP_FLAGS_TEXT "${IMRMLP_FLAGS_TEXT}")
string(REPLACE "-I. " "-I${IMRMLP_ROOT} " IMRMLP_FLAGS_TEXT "${IMRMLP_FLAGS_TEXT}")
string(REPLACE "-I runtime/mtp" "-I${IMRMLP_ROOT}/runtime/mtp" IMRMLP_FLAGS_TEXT "${IMRMLP_FLAGS_TEXT}")
separate_arguments(IMRMLP_ABI_FLAGS UNIX_COMMAND "${IMRMLP_FLAGS_TEXT}")
list(REMOVE_ITEM IMRMLP_ABI_FLAGS -MMD -MP)
get_filename_component(IMRMLP_LIBRARY_DIR "${IMRMLP_LIBRARY}" DIRECTORY)
find_package(MPI REQUIRED COMPONENTS CXX)
find_package(Eigen3 REQUIRED NO_MODULE)

function(native_target target)
  target_compile_features(${target} PRIVATE cxx_std_23)
  target_compile_options(${target} PRIVATE ${IMRMLP_ABI_FLAGS})
  target_include_directories(${target} PRIVATE "${LAMMPS_HEADER_DIR}" "${IMRMLP_ROOT}" "${IMRMLP_ROOT}/deplibs")
  target_link_libraries(${target} PRIVATE MPI::MPI_CXX Eigen3::Eigen "${IMRMLP_LIBRARY}")
  set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "${IMRMLP_LIBRARY_DIR}")
endfunction()
