include_guard(GLOBAL)
get_filename_component(IMRMLP_NATIVE_SOURCE "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

set(IMRMLP_NATIVE_TEST_DEVICE "cpu" CACHE STRING "Native regression backend: cpu, cuda, or hip")
set_property(CACHE IMRMLP_NATIVE_TEST_DEVICE PROPERTY STRINGS cpu cuda hip)
if(NOT IMRMLP_NATIVE_TEST_DEVICE MATCHES "^(cpu|cuda|hip)$")
  message(FATAL_ERROR "IMRMLP_NATIVE_TEST_DEVICE must be cpu, cuda, or hip")
endif()
set(IMRMLP_NATIVE_TEST_TIMEOUT "7200" CACHE STRING "Timeout in seconds for each native CTest")
if(NOT IMRMLP_NATIVE_TEST_TIMEOUT MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "IMRMLP_NATIVE_TEST_TIMEOUT must be a positive integer number of seconds")
endif()

function(native_add_tests executable plugin)
  add_executable(test_native_neighbor_order "${IMRMLP_NATIVE_SOURCE}/tests/test_neighbor_order.cpp")
  target_compile_features(test_native_neighbor_order PRIVATE cxx_std_23)
  add_test(NAME native_neighbor_order COMMAND test_native_neighbor_order)
  foreach(name neighbor_geometry candidate_geometry)
    add_executable(test_native_${name} "${IMRMLP_NATIVE_SOURCE}/tests/test_${name}.cpp")
    native_target(test_native_${name})
    add_test(NAME native_${name} COMMAND test_native_${name})
  endforeach()
  add_executable(generate_native_test_models "${IMRMLP_NATIVE_SOURCE}/tests/generate_models.cpp")
  native_target(generate_native_test_models)
  if(executable)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(environment "LD_LIBRARY_PATH=${IMRMLP_LIBRARY_DIR}:$ENV{LD_LIBRARY_PATH};OMP_NUM_THREADS=1;MKL_NUM_THREADS=1")
    if(NOT IMRMLP_NATIVE_TEST_DEVICE STREQUAL "cpu")
      list(APPEND environment "IMRMLP_REQUIRE_GPU=1")
    endif()
    set(plugin_args)
    if(plugin)
      list(APPEND plugin_args --plugin "${plugin}")
    endif()
    foreach(suite family_mpi nve workspace_mpi)
      if(suite STREQUAL "family_mpi")
        set(script run_regression.py)
        set(extra)
      elseif(suite STREQUAL "nve")
        set(script run_dynamics.py)
        set(extra --ranks 4)
      else()
        set(script run_workspace_regression.py)
        set(extra)
      endif()
      add_test(NAME native_lammps_${suite} COMMAND "${Python3_EXECUTABLE}"
        "${IMRMLP_NATIVE_SOURCE}/tests/${script}" --lmp "${executable}" ${plugin_args}
        --generator "$<TARGET_FILE:generate_native_test_models>" --device "${IMRMLP_NATIVE_TEST_DEVICE}" ${extra})
      set_tests_properties(native_lammps_${suite} PROPERTIES TIMEOUT "${IMRMLP_NATIVE_TEST_TIMEOUT}" ENVIRONMENT "${environment}")
    endforeach()
    add_test(NAME native_lammps_gpm COMMAND "${Python3_EXECUTABLE}"
      "${IMRMLP_NATIVE_SOURCE}/tests/run_regression.py" --lmp "${executable}" ${plugin_args}
      --generator "$<TARGET_FILE:generate_native_test_models>" --gpm --device "${IMRMLP_NATIVE_TEST_DEVICE}")
    set_tests_properties(native_lammps_gpm PROPERTIES TIMEOUT "${IMRMLP_NATIVE_TEST_TIMEOUT}" ENVIRONMENT "${environment}")
  endif()
endfunction()
