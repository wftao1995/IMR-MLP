units metal
atom_style atomic
boundary p p p
newton on

lattice fcc 4.05
region box block 0 2 0 2 0 2
create_box 1 box
create_atoms 1 box
mass 1 26.9815385
velocity all create 425.0 918273 mom no rot no dist gaussian
displace_atoms all random 0.031 0.027 0.019 77291 units box

pair_style mlip/transport/spline ${potential} 0
pair_coeff * *
neighbor 2.0 bin
neigh_modify every 1 delay 0 check no

compute ke all ke/atom
compute pe all pe/atom
compute stress all stress/atom NULL virial
compute conventional all heat/flux ke pe stress
compute transport all mlip/heat/flux

thermo 1
thermo_style custom step c_conventional[1] c_conventional[2] &
  c_conventional[3] c_conventional[4] c_conventional[5] c_conventional[6] &
  c_transport[1] c_transport[2] c_transport[3] c_transport[4] &
  c_transport[5] c_transport[6]
thermo_modify format float %.17g
run 0
